#!/bin/sh
# Persist `snap set bpilot <key>=<value>` settings so bpilot can read them.
#
# snapd invokes this hook on install and on every `snap set`/`snap unset`.
# We store the config as a JSON document in $SNAP_DATA/bpilot.conf, which
# src/bpilot/config.py reads on every invocation.
#
# `snapctl get -d` requires at least one key ("always return document, even
# with single key") — there is no "dump all config" form — so bpilot's known
# keys are enumerated explicitly. Keep this list in sync with config.py.
# Unset keys are omitted or null; config.py treats both as unset. The JSON
# is generated by snapd itself, so no escaping pitfalls. Write-then-mv keeps
# the update atomic so a running bpilot never reads a truncated file.
set -eu

tmp="$SNAP_DATA/bpilot.conf.tmp"
snapctl get -d openrouter-api-key model max-tokens > "$tmp"
mv "$tmp" "$SNAP_DATA/bpilot.conf"
